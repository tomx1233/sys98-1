# --- required ---------------------------------------------------------
# Postgres connection string (Neon, Supabase, Vercel Postgres, local, ...)
DATABASE_URL="postgresql://user:password@host:5432/system98"

# Random string, 32+ characters. Signs the staff login cookie.
#   openssl rand -base64 48
SESSION_SECRET=""

# Optional: separate key for encrypting 2FA secrets (defaults to SESSION_SECRET).
# Changing it later locks 2FA users out until an owner resets their 2FA.
TWO_FACTOR_SECRET=""

# Used exactly once: it lets you create the FIRST account (which becomes the owner)
# on /join. As soon as an owner exists it stops working. Pick something long.
SETUP_KEY=""

# Public address of the site, used in links inside emails.
SITE_URL="https://system98.org"

# --- optional: email --------------------------------------------------
# Without SMTP_HOST everything still works, visitors just don't get emails
# and rely on their ticket link.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM_ADDRESS="support@system98.org"
EMAIL_FROM_NAME="system98"

# Gets a short ping for every new ticket / visitor reply (needs SMTP above)
SUPPORT_NOTIFY_EMAIL=""

# --- optional: Discord bot (/audio, /user) ------------------------------
# Public key of your Discord application (Developer Portal > General Information).
# Discord signs every request with it; without it the bot endpoint stays switched off.
DISCORD_PUBLIC_KEY=""
# Application (client) ID. Used by `npm run discord:register` AND by /discord/invite
# (the custom install-link redirect), so this now needs to be set on the host too.
DISCORD_APP_ID=""
# Bot token. Used by `npm run discord:register` AND by the /status page's Discord
# check (proves the bot's credentials are still valid — set it on the host too).
DISCORD_BOT_TOKEN=""
# The /discord/invite page offers BOTH "add to account" (user install) and "add to server"
# (guild install). It needs DISCORD_APP_ID above. Optional: permissions bitfield for the server invite.
# Defaults to Send Messages + Embed Links + Attach Files + Read Message History.
DISCORD_INVITE_PERMISSIONS=""
# Optional: register the commands for ONE server only, they show up instantly (handy for testing)
DISCORD_GUILD_ID=""
# Optional: enables the /shazam song-recognition command. Free token from https://dashboard.audd.io
AUDD_API_TOKEN=""
